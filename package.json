{
  "name": "cs-dust-online",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Counter-Strike style browser FPS on Cloudflare Workers and Durable Objects (no R2)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public",
    "cf:login": "wrangler login",
    "sync": "cp shared/*.js public/shared/",
    "cf:deploy": "wrangler pages deploy public",
    "worker:dev": "wrangler dev --config wrangler.worker.toml",
    "worker:deploy": "wrangler deploy --config wrangler.worker.toml"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  }
}
